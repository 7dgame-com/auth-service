# Standalone adapter only; do not mount the F production env file.
DEVELOPMENT_PROVIDER_APP_ID=wx6f81800f15c9a88c
DEVELOPMENT_PROVIDER_IDENTITY_API_BASE_URL=http://identity-service:8086
DEVELOPMENT_PROVIDER_F_API_BASE_URL=https://auth.bujiaban.com
# Identity token-issuance scoped internal token; at least 32 bytes.
DEVELOPMENT_PROVIDER_IDENTITY_TOKEN=
# Equal to F AUTH_WECHAT_DEVELOPMENT_CAPABILITY_TOKEN; separate >=32-byte key.
DEVELOPMENT_PROVIDER_CAPABILITY_TOKEN=
# Equal to F AUTH_WECHAT_DEVELOPMENT_CALLBACK_TOKEN; third separate >=32-byte key.
DEVELOPMENT_PROVIDER_RELAY_TOKEN=
# Account has SELECT/INSERT/UPDATE only on auth_development_wechat_scenes.
# URL database must be xrugc_identity_dev or xrugc_identity_dev_rehearsal_<suffix>.
DEVELOPMENT_PROVIDER_DATABASE_URL=
DEVELOPMENT_PROVIDER_HOST=0.0.0.0
DEVELOPMENT_PROVIDER_PORT=3011
DEVELOPMENT_PROVIDER_TIMEOUT_MS=5000
