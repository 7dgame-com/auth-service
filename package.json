{
  "name": "unified-auth-service",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone unified auth center for bujiaban.com, 3dugc.com, and future services.",
  "main": "dist/run.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/run.js",
