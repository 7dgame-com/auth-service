NODE_ENV=production
AUTH_SERVICE_HOST=0.0.0.0
AUTH_SERVICE_PORT=3010
AUTH_PUBLIC_BASE_URL=https://auth.bujiaban.com
AUTH_CORS_ORIGINS=https://auth.bujiaban.com,https://bujiaban.com,https://3dugc.com
AUTH_DATABASE_AUTO_MIGRATE=true
AUTH_DATABASE_URL=
AUTH_TOKEN_SECRET=

# Legacy gdgeek/auth compatible database variables. Leave AUTH_DATABASE_URL empty to use these.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DB=
MYSQL_USERNAME=
MYSQL_PASSWORD=
JWT_KEY=/var/www/.ssh/ecc-private-key.pem

# WeChat Official Account. New names are preferred; old names are also accepted.
AUTH_WECHAT_OFFICIAL_APP_ID=
AUTH_WECHAT_OFFICIAL_APP_SECRET=
AUTH_WECHAT_OFFICIAL_TOKEN=
AUTH_WECHAT_OFFICIAL_AES_KEY=
WECHAT_APP_ID=
WECHAT_SECRET=
WECHAT_TOKEN=
WECHAT_AES_KEY=

# Development only.
AUTH_ALLOW_MOCK_WECHAT=false
AUTH_ENABLE_LEGACY_DEBUG_ENDPOINTS=false
